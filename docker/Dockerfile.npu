# lerobot on Ascend NPU (Atlas 800 / 950PR, CANN 9.2).
#
#   docker build -f docker/Dockerfile.npu -t lerobot-npu .
#
#   docker run -it --rm \
#     --device /dev/davinci0 --device /dev/davinci_manager \
#     --device /dev/devmm_svm --device /dev/hisi_hdc \
#     -v /usr/local/Ascend/driver:/usr/local/Ascend/driver:ro \
#     -v /usr/local/dcmi:/usr/local/dcmi:ro \
#     -v /usr/local/bin/npu-smi:/usr/local/bin/npu-smi:ro \
#     -e ASCEND_RT_VISIBLE_DEVICES=0 \
#     lerobot-npu
#
# Pick the cards per run with ASCEND_RT_VISIBLE_DEVICES; it is deliberately not baked in.
# The HF endpoint is likewise not set here — which mirror to use is per-site knowledge, and
# hardcoding it into the image makes the image lie about where weights come from.

# Ascend's own torch_npu image: CANN plus a matching torch_npu on a CPU-built torch, and
# nothing else. The tag encodes all four axes that have to line up --
# `<torch>.post<N>-cann<ver>-<SoC>-<os>-py<ver>`:
#
#   - `-950-`        : the SoC this is built for. The other branches (910b, 310p, a3) ship
#                      kernels for different hardware.
#   - `-ubuntu22.04-`: apt-based, which the system-package step below needs. The openeuler
#                      tags are dnf and would need that step rewritten.
#   - `2.10.0`       : held at the torch minor the policies here were validated against, so
#                      a CANN bump moves one variable and not two. The tags also offer 2.11
#                      and 2.12, both inside lerobot's `torch>=2.7,<2.16.0`.
#
# Verified on a 950PR against host driver 25.7.rc1.9: torch.npu available, a bf16 matmul,
# a ConvTranspose2d forward and a backward all run. CANN ships in the image but the driver
# is mounted from the host, so that pairing is a real precondition, not a formality.
#
# Replaces quay.io/ascend/vllm-ascend:v0.23.0-a5 (CANN 9.1), which was only ever used as a
# CANN+torch_npu base -- nothing here depended on vLLM.
#
# The default goes through the daocloud mirror because quay.io is not reachable from the CN
# builders; outside CN, strip the `m.daocloud.io/` prefix.
#
# The arg is NOT called BASE_IMAGE: the CI pipeline that builds this file passes
# `--build-arg BASE_IMAGE=...vllm-ascend:v0.23.0-a5` (CANN 9.1), and a --build-arg overrides
# an ARG default silently, so every "CANN 9.2" image built under that name was in fact 9.1.
# Naming the arg something the pipeline does not pass makes the version in this file the one
# that ships. Override it explicitly with --build-arg ASCEND_BASE_IMAGE=.
ARG ASCEND_BASE_IMAGE=m.daocloud.io/quay.io/ascend/torch-npu:2.10.0.post7-cann9.2.0-950-ubuntu22.04-py3.12
FROM ${ASCEND_BASE_IMAGE}

# Extras to install. The default covers the policies that have been exercised on NPU; add
# your own with --build-arg. Deliberately excluded:
#   - `all`      : drags in hardware/webrtc stacks that no NPU trainer needs.
#   - `hilserl`  : pulls placo (real-robot kinematics). SAC in simulation does not use it;
#                  gym-hil is installed directly below instead.
# `flux3` is included: NATTEN is indeed CUDA-only, but the `flux3` extra never asked for it
# (it resolves to `transformers-dep` alone), and the video VAE treats a missing NATTEN as the
# normal case off CUDA -- `_use_natten` admits only cuda and cpu, so an Ascend device takes
# the pure-torch neighborhood path by design. Measured on 950PR: it trains.
ARG LEROBOT_EXTRAS=dataset,training,transformers-dep,peft,diffusion,pi,smolvla,groot,eo1,evo1,xvla,wallx,molmoact2,multi_task_dit,lingbot_va,vla_jepa,fastwam,dreamzero,flux3,pusht,cosmos3,dm05,fineart_vla,g05,lawam,longwam,wall_oss_05

ENV DEBIAN_FRONTEND=noninteractive \
    # MuJoCo has to render the camera observations offscreen. EGL is not an option on an
    # Ascend host: an EGL device is a DRM render node (/dev/dri/renderD*) backed by a
    # graphics driver, and an NPU box exposes only /dev/davinci*, so EGL enumerates zero
    # devices even with libEGL installed. OSMesa rasterises on the CPU and needs no device.
    MUJOCO_GL=osmesa \
    PYOPENGL_PLATFORM=osmesa \
    # HCCL defaults to port 16666 and fails with "EI0020: reuse port" when anything else on
    # the host already holds it. Giving it a private range makes multi-card runs reproducible.
    HCCL_NPU_SOCKET_PORT_RANGE=25000-25200

# libosmesa6 is the renderer chosen above; libegl1/libgl1/libopengl0 are still needed
# because PyOpenGL resolves them at import time regardless of the platform in use.
# ffmpeg is for dataset video encoding (PyAV ships its own decode libs inside the wheel).
RUN apt-get update && apt-get install -y --no-install-recommends \
        libosmesa6 libegl1 libgl1 libopengl0 libglib2.0-0 \
        ffmpeg git curl build-essential \
    && rm -rf /var/lib/apt/lists/*

# Aliyun mirror: pulling from pypi.org inside CN turns a 3-minute build into a 40-minute one.
#
# Default rather than hardcoded, because the fastest mirror depends on where the build runs.
# On a Volcengine machine the internal mirror wins by a wide margin (measured against
# /pypi/simple/numpy/ from the Ascend host: ivolces 26 ms, aliyun 75 ms, volces 619 ms) but
# mirrors.ivolces.com does not even resolve outside their network, so it cannot be the
# default. A build arg is the right knob here and a pipeline environment variable is not:
# the latter never reaches a RUN layer.
#   --build-arg PIP_INDEX=https://mirrors.ivolces.com/pypi/simple/ --build-arg PIP_HOST=mirrors.ivolces.com
ARG PIP_INDEX=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_HOST=mirrors.aliyun.com

# A fallback index for the one install below that needs it. A mirror can lag upstream, and
# a lagging mirror does not degrade gracefully -- it makes a pin unsatisfiable and fails the
# build. Both Volcengine mirrors stopped at gym-hil 0.1.13 while the floor further down is
# 0.1.14, which is how this was found; Aliyun and pypi.org both had it.
#
# It is applied per-command rather than through PIP_EXTRA_INDEX_URL, because globally it is
# expensive: pip then queries both indexes for every candidate, and that took the big
# `pip install -e .[extras]` step from 34 s to 938 s on the CP builder. Scoped to the one
# package that needs it, the same fix costs nothing measurable.
#
# Safe only because both indexes mirror the same upstream. Never point this at a second,
# unrelated package source -- with two indexes pip takes the highest version it finds in
# either, which is the dependency-confusion shape.
ARG PIP_EXTRA_INDEX=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_EXTRA_HOST=mirrors.aliyun.com

# pip splits the list-valued env vars on whitespace, which is how both hosts get trusted.
ENV PIP_INDEX_URL=${PIP_INDEX} \
    PIP_TRUSTED_HOST="${PIP_HOST} ${PIP_EXTRA_HOST}" \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# torchvision is a hard dependency (`torchvision>=0.22.0,<0.30.0`) that this base image does
# not ship, unlike the vLLM one it replaces. Left to the extras install it would come from
# PyPI, whose linux torchvision wheels are CUDA builds -- unusable on an Ascend device and a
# CUDA torch away from breaking torch_npu's ABI. So it is installed here, explicitly, from a
# CPU-wheel index, and BEFORE the constraint below so the constraint pins it too.
#
# 0.25.x is the release built against torch 2.10 (0.26 pairs with 2.11), the same version the
# previous base image carried. The index is Aliyun's flat mirror of download.pytorch.org,
# which actually hosts the files in China -- the same reason pyproject.toml's `pytorch-cu128`
# index points there. `--find-links` and not `--index-url` because the mirror is a directory
# listing, not a PEP 503 index; the regular index stays available for pillow and numpy.
#
# The check below reads the installed version instead of importing torchvision, because
# `import torch` cannot work during a build on this base: torch auto-loads the torch_npu
# backend, torch_npu needs libascend_hal.so, and that lives in the host driver which is
# mounted at run time and absent here. What matters at build time is which wheel landed --
# a plain `torchvision` would be the CUDA build and must fail the step.
ARG TORCHVISION_FIND_LINKS=https://mirrors.aliyun.com/pytorch-wheels/cpu/
RUN pip install --no-cache-dir --find-links "${TORCHVISION_FIND_LINKS}" \
        'torchvision==0.25.0+cpu' \
 && v=$(python3 -c "import importlib.metadata as m; print(m.version('torchvision'))") \
 && echo "torchvision installed: $v" \
 && case "$v" in *+cpu) ;; *) echo "expected a +cpu build, got $v" >&2; exit 1 ;; esac

# Freeze the base image's torch stack into a pip constraint before installing anything.
# lerobot asks for `torch>=2.7,<2.16.0`, which the CPU build already satisfies -- but any
# extra that nudges the resolver is one CUDA wheel away from replacing it, and torch_npu
# then refuses to load against the mismatched ABI. The constraint makes that impossible
# rather than merely unlikely. Generated, not hardcoded, so it stays correct when
# ASCEND_BASE_IMAGE is bumped.
#
# This is also why the install below uses pip and not `uv sync`: `[tool.uv.sources]` in
# pyproject.toml points torchvision at the pytorch-cu128 index on Linux. pip ignores that
# table entirely; uv would honour it and pull a CUDA torchvision.
RUN for p in torch torchvision torchaudio torch-npu; do \
        v=$(python3 -c "import importlib.metadata as m; print(m.version('$p'))" 2>/dev/null) \
          && echo "$p==$v" >> /etc/pip-torch-constraints.txt; \
    done && cat /etc/pip-torch-constraints.txt
ENV PIP_CONSTRAINT=/etc/pip-torch-constraints.txt

WORKDIR /lerobot
COPY . .

# The packages whose floor the Volcengine mirror cannot satisfy, installed first and from the
# fallback index, for the same reason as gym-hil below. v0.7.0 raised several floors past that
# mirror's snapshot (it has draccus 0.11.5 but no 0.11.6, filelock 3.29.4 but no 4.x), and a
# lagging mirror makes the pin unsatisfiable and fails the install outright.
#
# The list is every direct or extra dependency whose floor was published after that snapshot,
# which is inferred from the two versions the mirror was observed to be missing rather than
# measured against the mirror itself. So it may name a package the mirror actually carries --
# harmless, since both indexes mirror the same upstream and pip then just installs the same
# version from either.
#
# Installing them here leaves them already satisfied for the big install, so that step still
# queries a single index and keeps its 34 s instead of the 938 s a global --extra-index-url
# cost. Add to this line when a new floor outruns the mirror; the symptom is always
# "Could not find a version that satisfies the requirement <pkg>" with the mirror's highest
# version listed just below the floor.
RUN pip install --no-cache-dir --extra-index-url "${PIP_EXTRA_INDEX}" \
        'draccus>=0.11.6,<0.12.0' \
        'filelock>=4.2.1,<5.0.0' \
        'huggingface-hub>=1.31.0' \
        'transformers>=5.22.0,<5.23.0' \
        'trackio>=0.44.0' \
        'gym-pusht>=0.1.8'

RUN pip install --no-cache-dir -e ".[${LEROBOT_EXTRAS}]"

# The SAC / HIL-SERL simulator, installed on its own rather than via the `hilserl` extra so
# that placo (real-robot kinematics, unused in simulation) stays out. This single line is
# what pulls MuJoCo in; gym-pusht arrives with the `pusht` extra above and needs only pymunk.
# gym-hil is classic MuJoCo, not MuJoCo Warp, so the physics runs on the CPU while the
# policy runs on the NPU — that split is what makes closed-loop RL possible on a machine
# with no graphics hardware at all.
# --extra-index-url because 0.1.14 is newer than the Volcengine mirrors carry; see the
# PIP_EXTRA_INDEX comment above for why the fallback is scoped to this line and not global.
RUN pip install --no-cache-dir --extra-index-url "${PIP_EXTRA_INDEX}" 'gym-hil>=0.1.14,<0.2.0'

# Re-pin torchcodec to the release built against this image's torch. Every torchcodec is
# compiled against one specific torch (0.9<->2.9, 0.10<->2.10, 0.11<->2.11), but the
# [dataset] extra only asks for `torchcodec>=0.3.0,<0.12.0` and never mentions torch, so pip
# resolves to the top of that range. On a torch 2.10 image that is 0.11.x, whose
# libtorchcodec_core*.so then fails to load with
#   undefined symbol: torch_dtype_float4_e2m1fn_x2
#
# That failure is not contained. lerobot catches it and falls back to PyAV -- a mere warning
# -- but the half-initialised link map glibc is left holding makes every later
# pthread_create abort the process with
#   Inconsistency detected by ld.so: dl-tls.c: _dl_allocate_tls_init: Assertion `listp != NULL'
# which kills open-loop eval long after that warning has scrolled past. Enlarging the static
# TLS surplus via GLIBC_TUNABLES does not help: the surplus is not what ran out.
#
# FFmpeg is a red herring here. torchcodec supports 4 through 9 and uses the system copy;
# the `libavutil.so.57/58/59/60: cannot open shared object file` lines are just it probing
# 8->7->6->5->4 and missing the ones not installed. The image's 4.4.2 decodes fine.
#
# What this pin buys is a working CPU decoder, NOT hardware decoding. torchcodec's
# accelerated path is NVDEC behind device="cuda", and there is no Ascend equivalent: both
# device="npu" and device="cuda" raise `Unsupported device ... (variant: ffmpeg)` here --
# npu because torchcodec has no DVPP/VDEC backend, cuda because this wheel is the plain
# ffmpeg variant. So decoding runs on the CPU through the same ffmpeg PyAV would use. What
# is left over PyAV is a saved numpy->tensor copy and exact-seek random access; both are
# worth having, neither is a different order of magnitude. The reason to pin rather than
# uninstall is the failure mode above, not throughput.
#
# Derived rather than hardcoded so it stays correct when ASCEND_BASE_IMAGE moves. The 2.X <-> 0.X
# rule holds from torch 2.9 onwards; if a future base predates that, this fails loudly at
# build time, which is the point.
#
# TORCH_DEVICE_BACKEND_AUTOLOAD=0 because `import torch` otherwise auto-imports torch_npu,
# which dlopens libascend_hal.so -- a DRIVER library, present only on a host with Ascend
# cards. A CI builder has none, so plain `import torch` dies there with
#   ImportError: libascend_hal.so: cannot open shared object file
#   RuntimeError: Failed to load the backend extension: torch_npu
# even though nothing here needs the NPU. Set per-RUN rather than as ENV: as ENV it would
# survive into the image and change how torch behaves at training time.
RUN TC=$(TORCH_DEVICE_BACKEND_AUTOLOAD=0 python3 -c "import torch; print('.'.join(torch.__version__.split('+')[0].split('.')[:2]))") \
    && TC_MINOR=${TC#2.} \
    && echo "torch ${TC} -> torchcodec 0.${TC_MINOR}.*" \
    && pip install --no-cache-dir "torchcodec==0.${TC_MINOR}.*"

# Fail the build, not the first training run, if any of the above silently regressed.
#
# Autoload off for the same reason as above, which is also why torch_npu is checked through
# its metadata instead of being imported: importing it needs the driver and there is no way
# to verify it on a machine with no cards. That it loads at all is what the first run on
# real hardware proves; what this can prove is that it is installed and that nothing in the
# install above replaced the CPU torch it was built against.
RUN TORCH_DEVICE_BACKEND_AUTOLOAD=0 python3 -c "\
import importlib.metadata as md, importlib.util as u, torch;\
assert not torch.version.cuda, f'expected a CPU torch build, got CUDA {torch.version.cuda}';\
tn = md.version('torch-npu');\
assert u.find_spec('av') is not None, 'PyAV missing: no video decoder left';\
assert all(u.find_spec(m) for m in ('gym_hil','gym_pusht','mujoco')), 'sim stack incomplete';\
import torchcodec.decoders;\
from lerobot.utils.import_utils import get_safe_default_video_backend as b;\
assert b() == 'torchcodec', f'torchcodec present but unloadable, probe chose {b()!r} -- see the pin above';\
import lerobot, torchcodec; print('torch', torch.__version__, '| torch_npu', tn, '| torchcodec', torchcodec.__version__, '| lerobot', lerobot.__version__)"

CMD ["/bin/bash"]
